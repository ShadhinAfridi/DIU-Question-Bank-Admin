<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/userPicture"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@drawable/background_image"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize50Percent"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_person"
        android:padding="@dimen/_5sdp"
        />


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/userName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="User Name"
        app:layout_constraintStart_toEndOf="@id/userPicture"
        app:layout_constraintTop_toTopOf="@id/userPicture"
        android:layout_marginStart="@dimen/_5sdp"
        android:textStyle="bold"
        android:textColor="@color/primary_text"
        android:textSize="@dimen/_10sdp"
        />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/userEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="User Email"
        app:layout_constraintStart_toEndOf="@id/userPicture"
        app:layout_constraintTop_toBottomOf="@id/userName"
        app:layout_constraintBottom_toTopOf="@id/userAvailable"
        android:layout_marginStart="@dimen/_5sdp"
        android:textColor="@color/secondary_text"
        android:textSize="@dimen/_8sdp"
        />
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/userAvailable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Online"
        app:layout_constraintStart_toEndOf="@id/userPicture"
        app:layout_constraintTop_toBottomOf="@id/userEmail"
        app:layout_constraintBottom_toBottomOf="@id/userPicture"
        android:layout_marginStart="@dimen/_5sdp"
        android:textColor="#388E3C"
        android:textSize="@dimen/_8sdp"
        />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintTop_toBottomOf="@id/userAvailable"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="#619B9B9B"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        />

</androidx.constraintlayout.widget.ConstraintLayout>